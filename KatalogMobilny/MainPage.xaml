<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.MainPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="procesor" FontSize="12" FontAttributes="Bold" TextColor="#0000FF" HorizontalOptions="Center" Margin="0, 20" />
        <Image Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Source="cpu.webp" Aspect="AspectFit" />
        <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="Cena: 679,00 zl" TextColor="Gray" />
        <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="EtykietaWyniku" Text="Nic nie wybrano" />
        <Button Grid.Row="5" Grid.Column="0" Text="Pokaż" Clicked="PokazClicked" />
        <Button Grid.Row="5" Grid.Column="1" Text="Ukryj" />
        <FlexLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Wrap="Wrap" JustifyContent="Center">
            <Button Text="Procesory" />
            <Button Text="Płyty Główne" />
            <Button Text="Karty Graficzne" />
            <Button Text="Dyski SSD" />
            <Button Text="Pamięci RAM" />
        </FlexLayout>
    </Grid>
